# All settings use the VIDEO_SUMMARIZER_ env prefix (see video_summarizer/config.py)

# LLM Provider: mock, openai, ollama
VIDEO_SUMMARIZER_LLM_PROVIDER=mock

# OpenAI Configuration
VIDEO_SUMMARIZER_OPENAI_API_KEY=
VIDEO_SUMMARIZER_OPENAI_BASE_URL=https://api.openai.com/v1
VIDEO_SUMMARIZER_OPENAI_MODEL=gpt-3.5-turbo

# Ollama Configuration
VIDEO_SUMMARIZER_OLLAMA_BASE_URL=http://localhost:11434
VIDEO_SUMMARIZER_OLLAMA_MODEL=llama2

# Whisper Configuration
VIDEO_SUMMARIZER_WHISPER_MODEL=base
VIDEO_SUMMARIZER_WHISPER_DEVICE=cpu
VIDEO_SUMMARIZER_WHISPER_COMPUTE_TYPE=int8

# Chunk Settings (minutes)
VIDEO_SUMMARIZER_CHUNK_DURATION_MIN=3
VIDEO_SUMMARIZER_CHUNK_DURATION_MAX=5

# Output Settings
VIDEO_SUMMARIZER_OUTPUT_DIR=~/video_summarizer_output
